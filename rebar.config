{erl_opts, [debug_info]}.

% Native -doc/-moduledoc attributes need OTP 27 or later.
{minimum_otp_vsn, "27"}.

{project_plugins, [rebar3_ex_doc]}.

{hex, [{doc, #{provider => ex_doc}}]}.

{ex_doc, [
    {extras, ["README.md", "LICENSE"]},
    {main, "README.md"},
    {source_url, "https://github.com/mk270/realpath"}
]}.

{deps, []}.

% eunit.hrl adds a test/0 that calls eunit:test/1, so eunit must be in the PLT.
{dialyzer, [{plt_extra_apps, [eunit]}]}.
